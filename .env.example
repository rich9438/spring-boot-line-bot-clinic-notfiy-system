 # 複製為 .env 後填入實際值（.env 不可提交到版控）
DB_NAME=clinic
DB_USERNAME=clinic
DB_PASSWORD=change-me
LINE_CHANNEL_TOKEN=
LINE_CHANNEL_SECRET=
# 選填：deploy/flex-samples/send-sample.sh 推播卡片範例到自己的 LINE（Developers Console → Basic settings → Your user ID）
LINE_USER_ID=

# 後台管理 Bot（選填；同 Provider 下另建一個 Messaging API Channel）
ADMIN_ENABLED=false
ADMIN_LINE_CHANNEL_TOKEN=
ADMIN_LINE_CHANNEL_SECRET=
# 管理者 userId，逗號分隔（先加後台好友並傳任意訊息，Bot 會回覆你的 userId）
ADMIN_LINE_USER_IDS=
